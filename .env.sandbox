# Variables SOLO para el sandbox. No uses estos valores en producción.
# Exponer el servicio en 0.0.0.0 exige un token de cliente (ver main.py).
SOLOBINO_CLIENT_TOKEN=sandbox-token-de-prueba
AGENT_PROVIDER=ollama
# Ollama no corre en el sandbox: el backend arranca igual y /health responde.
OLLAMA_BASE_URL=http://host.docker.internal:11434
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
