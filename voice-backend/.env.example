# Plantilla de configuración. Copia a .env y ajusta. Nunca subas el .env real.

# --- Modelo ---
# El servicio puede usar un Ollama local o uno accesible por red privada.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
AGENT_PROVIDER=ollama
# Opcional: 0 fuerza CPU si el controlador CUDA falla al cargar el modelo.
# OLLAMA_NUM_GPU=0

# --- Servicio para clientes Windows y macOS ---
# Usa 0.0.0.0 solo detrás de una red privada o un proxy TLS (wss://).
SOLOBINO_HOST=127.0.0.1
SOLOBINO_PORT=8000
# Obligatorio al exponer el servicio en red. Usa un valor aleatorio distinto.
# SOLOBINO_CLIENT_TOKEN=pon-aqui-un-token-largo

# --- Transcripción ---
# Sin valores, el backend elige según el sistema:
#   Windows -> medium / cuda / float16      macOS -> small / cpu / int8
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# --- Palabra de activación ---
WAKEWORD_USE_CNN=false
WAKE_HOTWORD=solobino
WAKE_FUZZY_RATIO=0.90
WAKE_COOLDOWN_S=2

# --- Catálogo de música ---
ITUNES_COUNTRY=GT

# --- OpenClaw (opcional, solo si AGENT_PROVIDER=openclaw) ---
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18790
# OPENCLAW_GATEWAY_TOKEN=pon-aqui-tu-token
