# Plantilla de configuración. Copia a .env y ajusta. Nunca subas el .env real.

# --- Modelo ---
# En el Mac apunta al Ollama de la PC por Tailscale (IP de la tailnet, no localhost).
OLLAMA_BASE_URL=http://100.126.148.82:11434
OLLAMA_MODEL=qwen3.5:4b
AGENT_PROVIDER=ollama

# --- Transcripción ---
# Sin valores, el backend elige según el sistema:
#   Windows -> medium / cuda / float16      macOS -> small / cpu / int8
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# --- Palabra de activación ---
WAKEWORD_USE_CNN=false
WAKE_HOTWORD=solobino
WAKE_COOLDOWN_S=2

# --- Catálogo de música ---
ITUNES_COUNTRY=GT

# --- OpenClaw (opcional, solo si AGENT_PROVIDER=openclaw) ---
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18790
# OPENCLAW_GATEWAY_TOKEN=pon-aqui-tu-token
